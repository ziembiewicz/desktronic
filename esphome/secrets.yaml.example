# Copy to secrets.yaml (or add the keys to the Secrets editor in ESPHome Device Builder).
# Never commit the real file.
wifi_iot_ssid: "your-iot-network"
wifi_iot_password: "your-wifi-password"
# 32 random bytes, base64: openssl rand -base64 32
desktronic_api_key: "REPLACE_WITH_BASE64_KEY"
# The device announces itself as desktronic-<last 6 hex digits of its MAC>.local (see README).
desktronic_address: "desktronic-xxxxxx.local"
